# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=5000

# Local MongoDB:      mongodb://localhost:27017/campusease
# MongoDB Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusease
MONGO_URI=mongodb://localhost:27017/campusease

# Use a long random string in production, e.g. output of: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Free API key from https://console.groq.com (Admin AI Booking Assistant)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Password reset emails ---
# Leave SMTP_* blank for local dev: the reset code is then shown on the
# Forgot Password screen (a test mail sandbox never reaches a real inbox).
# For a real deployment, fill these in AND set NODE_ENV=production so the
# code is no longer returned in the API response.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NODE_ENV=development
